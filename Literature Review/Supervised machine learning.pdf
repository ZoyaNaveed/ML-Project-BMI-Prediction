      <pdfaExtension:schemas>
        <rdf:Bag>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/xap/1.0/mm/"
              pdfaSchema:prefix="xmpMM"
              pdfaSchema:schema="XMP Media Management">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="UUID based identifier for specific incarnation of a document"
                  pdfaProperty:name="InstanceID"
                  pdfaProperty:valueType="URI"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="The common identifier for all versions and renditions of a document."
                  pdfaProperty:name="OriginalDocumentID"
                  pdfaProperty:valueType="URI"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="A reference to the original document from which this one is derived. It is a minimal reference; missing components can be assumed to be unchanged. For example, a new version might only need to specify the instance ID and version number of the previous version, or a rendition might only need to specify the instance ID and rendition class of the original."
                  pdfaProperty:name="DerivedFrom"
                  pdfaProperty:valueType="ResourceRef"/>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li
                  pdfaType:description="Identifies a portion of a document. This can be a position at which the document has been changed since the most recent event history (stEvt:changed). For a resource within an xmpMM:Ingredients list, the ResourceRef uses this type to identify both the portion of the containing document that refers to the resource, and the portion of the referenced resource that is referenced."
                  pdfaType:namespaceURI="http://ns.adobe.com/xap/1.0/sType/Part#"
                  pdfaType:prefix="stPart"
                  pdfaType:type="Part"/>
              </rdf:Seq>
            </pdfaSchema:valueType>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/pdf/1.3/"
              pdfaSchema:prefix="pdf"
              pdfaSchema:schema="Adobe PDF">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="A name object indicating whether the document has been modified to include trapping information"
                  pdfaProperty:name="Trapped"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/xap/1.0/t/pg/"
              pdfaSchema:prefix="xmpTPg"
              pdfaSchema:schema="XMP Paged-Text">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="XMP08 Spec: An ordered array of plate names that are needed to print the document (including any in contained documents)."
                  pdfaProperty:name="PlateNames"
                  pdfaProperty:valueType="Seq Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/pdfx/1.3/"
              pdfaSchema:prefix="pdfx"
              pdfaSchema:schema="pdfx">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="ID of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXVersion"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Conformance level of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXConformance"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Company creating the PDF"
                  pdfaProperty:name="Company"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Date when document was last modified"
                  pdfaProperty:name="SourceModified"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Mirrors crossmark:CrosMarkDomains"
                  pdfaProperty:name="CrossMarkDomains"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Mirrors crossmark:CrossmarkDomainExclusive"
                  pdfaProperty:name="CrossmarkDomainExclusive"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Mirrors crossmark:MajorVersionDate"
                  pdfaProperty:name="CrossmarkMajorVersionDate"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Mirrors crossmark:DOI"
                  pdfaProperty:name="doi"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://www.aiim.org/pdfa/ns/id/"
              pdfaSchema:prefix="pdfaid"
              pdfaSchema:schema="PDF/A ID Schema">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Part of PDF/A standard"
                  pdfaProperty:name="part"
                  pdfaProperty:valueType="Integer"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Amendment of PDF/A standard"
                  pdfaProperty:name="amd"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Conformance level of PDF/A standard"
                  pdfaProperty:name="conformance"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://crossref.org/crossmark/1.0/"
              pdfaSchema:prefix="crossmark"
              pdfaSchema:schema="crossmark">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="CrossMarkDomains"
                  pdfaProperty:name="CrossMarkDomains"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="CrossmarkDomainExclusive"
                  pdfaProperty:name="CrossmarkDomainExclusive"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Usual same as prism:doi"
                  pdfaProperty:name="DOI"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="The date when a publication was published."
                  pdfaProperty:name="MajorVersionDate"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://prismstandard.org/namespaces/basic/2.0/"
              pdfaSchema:prefix="prism"
              pdfaSchema:schema="Prism">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="The aggregation type specifies the unit of aggregation for a content collection. &#xA;Comment &#xA;PRISM recommends that the PRISM Aggregation Type Controlled Vocabulary be used to provide values for this element. &#xA;Note: PRISM recommends against the use of the #other value currently allowed in this controlled vocabulary. In lieu of using #other please reach out to the PRISM group at info@prismstandard.org to request addition of your term to the Aggregation Type Controlled Vocabulary. &#xA;&#xA;"
                  pdfaProperty:name="aggregationType"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://www.niso.org/schemas/jav/1.0/"
              pdfaSchema:prefix="jav"
              pdfaSchema:schema="NISO">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Values for Journal Article Version are one of the following:&#xA;AO = Authorâ€™s Original&#xA;SMUR = Submitted Manuscript Under Review&#xA;AM = Accepted Manuscript&#xA;P = Proof&#xA;VoR = Version of Record&#xA;CVoR = Corrected Version of Record&#xA;EVoR = Enhanced Version of Record"
                  pdfaProperty:name="journal_article_version"
                  pdfaProperty:valueType="Closed Choice of Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
        </rdf:Bag>
      </pdfaExtension:schemas>
